// ─── Helpers ────────────────────────────────────────────────────────────────
const BADGES: Record<string, string> = { GA: 'ga', 'PUBLIC PREVIEW': 'preview', PREVIEW: 'preview', BETA: 'beta', NEW: 'new' };
const Badge = ({ status }: { status: string }) => (
  <span className={`badge badge-${BADGES[(status || 'New').toUpperCase()] ?? 'new'}`}>{status || 'New'}</span>
);

/** Renders `**bold** lead-ins` inside list items and value text. */
const rich = (s: string): ReactNode[] =>
  s.split(/(\*\*[^*]+\*\*)/g).map((part, i) =>
    part.startsWith('**') && part.endsWith('**') ? <strong key={i}>{part.slice(2, -2)}</strong> : part,
  );

const Ext = ({ href, children }: { href: string; children: ReactNode }) => (
  <a href={href} target="_blank" rel="noreferrer">{children}</a>
);

/**
 * Auto-fit: step the base font size down (18px → 14px) until no `.pillar` / `.card` / `.spot-value`
 * overflows. The final size lands on `data-fit` and `data-overflow` so the verify step can read them;
 * below 15px, or `data-overflow="true"` (still clipped at 14px), the slide is too dense: cut an item.
 */
function useFit() {
  const ref = useRef<HTMLDivElement>(null);
  useLayoutEffect(() => {
    const root = ref.current;
    if (!root) return;
    const fit = () => {
      let size = 18;
      root.style.fontSize = `${size}px`;
      const overflowing = () =>
        [...root.querySelectorAll<HTMLElement>('.pillar, .card, .spot-value')].some(
          (el) => el.scrollHeight > el.clientHeight + 1,
        );
      while (overflowing() && size > 14) {
        size -= 0.5;
        root.style.fontSize = `${size}px`;
      }
      root.dataset.fit = String(size);
      root.dataset.overflow = String(overflowing());
    };
    fit();
    document.fonts?.ready.then(fit);
  }, []);
  return ref;
}

