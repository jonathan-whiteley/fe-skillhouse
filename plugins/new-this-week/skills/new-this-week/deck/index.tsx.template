  </div>
);

const Foot = () => (
  <div className="foot">
    <span>
      Prepared for <strong>{CONTENT.customer}</strong> by your Databricks account team
    </span>
    <span>Status reflects public Databricks documentation as of {CONTENT.as_of}. Preview features may change before GA.</span>
  </div>
);

const ItemView = ({ it }: { it: Item }) => (
  <div className={`item${it.headline ? ' headline' : ''}`}>
    <div className="item-head">
      <Badge status={it.status} />
      <h3>
        <Ext href={it.url}>{it.title}</Ext>
      </h3>
      {it.date && <span className="date">{it.date}</span>}
    </div>
    <p className="what">{it.what}</p>
    <p className="why">
      <span className="why-label">For {CONTENT.customer}:</span> {it.why}
    </p>
  </div>
);

// ─── Pages ──────────────────────────────────────────────────────────────────
const Overview: Page = () => {
  const ref = useFit();
  const kicker = `${CONTENT.kicker ?? 'New This Week'} · Databricks product updates`;
  return (
    <div className="ntw" ref={ref}>
      <Top
        kicker={kicker}
        title={
          <>
            What's new for {CONTENT.customer}
            <span className="asof">({CONTENT.window_label ?? `as of ${CONTENT.as_of}`})</span>
          </>
        }
        sub={CONTENT.subtitle}
      />
      <div className="pillars">
        {CONTENT.pillars.map((p, i) => (
          <section className="pillar" key={p.name}>
            <div className="pillar-head">
              <div className="pillar-num">{String(i + 1).padStart(2, '0')}</div>
              <h2>{p.name}</h2>
              {p.tagline && <p className="tagline">{p.tagline}</p>}
            </div>
            <div className="items">
              {p.items.map((it) => (
                <ItemView key={it.title} it={it} />
              ))}
            </div>
          </section>
        ))}
      </div>
      <Foot />
    </div>
  );
};

const spotlightPage = (s: Spotlight): Page => {
  const SpotlightPage: Page = () => {
    const ref = useFit();
    return (
      <div className="ntw" ref={ref}>
        <Top kicker={`Feature spotlight · ${CONTENT.kicker ?? 'New This Week'}`} title={s.title} sub={s.tagline} />
        <div className="spot">
          <div className="spot-value">
            <div className="meta">
              <Badge status={s.status} />
              {s.date && <span className="date">{s.date}</span>}
            </div>
            <p className="value">{rich(s.value)}</p>
            <div>
              <h4>For {CONTENT.customer}</h4>
              <ul>{s.for_customer.map((b) => <li key={b}>{rich(b)}</li>)}</ul>
            </div>
            <div className="links">
              <Ext href={s.url}>Documentation</Ext>
              {(s.links ?? []).map((l) => (
                <Ext key={l.url} href={l.url}>{l.label}</Ext>
              ))}
            </div>
          </div>
          <div className="spot-right">
            <div className="card">
              <h4>How it works</h4>
              <div className="steps">
                {s.steps.map((st, i) => (
                  <div className="step" key={st.title}>
                    <div className="step-num">{i + 1}</div>
                    <div>
                      <div className="step-title">{st.title}</div>
                      <div className="step-body">{rich(st.body)}</div>
                      {st.code && st.code.length > 0 && (
                        <div className="code">
                          {st.code.map((c) => (
                            <div className="code-row" key={c.cmd}>
                              <span>{c.label}</span>
                              <code>{c.cmd}</code>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div className="pair">
              <div className="card">
                <h4>What admins control</h4>
                <ul>{s.controls.map((b) => <li key={b}>{rich(b)}</li>)}</ul>
              </div>
              <div className="card">
                <h4>What you can see</h4>
                <ul>{s.observe.map((b) => <li key={b}>{rich(b)}</li>)}</ul>
              </div>
            </div>
          </div>
        </div>
        <Foot />
      </div>
    );
  };
  return SpotlightPage;
};

